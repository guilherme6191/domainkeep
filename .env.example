# Copy to .env.local and fill in. Never commit the filled-in file.

# --- Clerk (authentication) -------------------------------------------------
# From the Clerk dashboard: API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_
CLERK_SECRET_KEY=sk_test_

# Where Clerk sends users. Defaults are fine for local development.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Supabase -----------------------------------------------------------------
# The app talks to the database through Supabase's Data API. Reads carry the
# caller's Clerk session token, so the database's own row-level policies decide
# which rows each request may see. Writes use the secret key, which only the
# server holds. Two one-time dashboard steps make the token part work:
#   1. Clerk dashboard > Integrations > Supabase > Activate. Copy the Clerk domain.
#   2. Supabase dashboard > Authentication > Sign In / Providers > Add provider
#      > Clerk. Paste the Clerk domain.
#
# From the Supabase dashboard: Project Settings > Data API (the URL) and
# Project Settings > API Keys (the publishable key, formerly "anon", and the
# secret key, formerly "service_role"). The secret key never gets a
# NEXT_PUBLIC_ prefix.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_
SUPABASE_SECRET_KEY=sb_secret_

# Only `pnpm db:migrate` uses this. From the "Connect" button at the top of the
# project page > ORMs tab > Prisma: take DIRECT_URL, the session pooler on port
# 5432. The direct db.<ref>.supabase.co host is IPv6-only without the IPv4
# add-on. If the password contains @ : / ? or #, percent-encode it (@ is %40).
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Resend (optional) --------------------------------------------------------
# Only used to email the previous holder when their domain is taken over. Leave
# the key empty and nothing is sent; the superseded claim in their list is still
# the in-app signal, so local development works without any of this.
#
# From the Resend dashboard: API Keys; the value starts with `re_`. Leaving it
# empty is what keeps the mailer a no-op, so fill it in only when you want mail.
# RESEND_FROM must be an address on a domain verified in that account — until
# you verify one, the sandbox sender below delivers to your own address only.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Absolute base for the link in that email. Set it in any deployment; locally
# the request origin is used when it is unset. Never trusted from the request in
# production, because the request that triggers the email is the new holder's.
NEXT_PUBLIC_APP_URL=http://localhost:3000
